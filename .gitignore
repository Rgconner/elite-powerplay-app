# Visual Inspector — gitignore

# --- Runtime data (never commit user state, captures, references) ---
/data/
!/data/.gitkeep
/data/references/
/data/captures/
/data/alerts/
/data/mock_pins.json
/data/visinsp.db
/data/visinsp.db-*
/data/threshold_history.json

# Active user config (the templates in /config/*.example.json are committed)
/config/config.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# --- Virtual environments ---
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- IDEs / editors ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Test / coverage artifacts ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.cache
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# --- Logs ---
*.log
logs/

# --- OS / misc ---
[Tt]humbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- PyInstaller / frozen binaries ---
pip-log.txt
pip-delete-this-directory.txt

# --- Jupyter / Notebooks ---
.ipynb_checkpoints/
profile_default/
ipython_config.py

# --- Generated docs ---
docs/_build/
site/

# --- Celery (just in case) ---
celerybeat-schedule
celerybeat.pid

# --- MyPy ---
.mypy_cache/

# --- Node (kept for any future web tooling) ---
node_modules/
npm-debug.log
yarn-error.log

# --- Mock / sample data only used at runtime ---
*.swp
*.bak
*~
